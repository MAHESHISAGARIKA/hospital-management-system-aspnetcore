@model HospitalManagementSystem.Web.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}
<section class="hms-login-wrap" aria-labelledby="login-heading">
    <div class="card hms-login">
        <span class="hms-brand-mark" aria-hidden="true">+</span>
        <h1 id="login-heading">Sign in</h1>
        <p class="hms-muted">Use your hospital account to access your workspace.</p>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
        <form asp-action="Login" asp-controller="Account" method="post">
            <input asp-for="ReturnUrl" type="hidden" />
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" aria-describedby="email-error" />
                <span asp-validation-for="Email" id="email-error" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Password" class="form-control" autocomplete="current-password" aria-describedby="password-error" />
                    <button class="btn btn-outline-secondary" type="button" data-password-toggle aria-controls="Password" hidden>Show password</button>
                </div>
                <span asp-validation-for="Password" id="password-error" class="text-danger"></span>
            </div>
            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-primary w-100">Sign in</button>
        </form>
    </div>
</section>
