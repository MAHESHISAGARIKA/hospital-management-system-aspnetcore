@model HospitalManagementSystem.Web.Models.ViewModels.DoctorEditViewModel
<div class="row g-3">
    <div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="RegistrationNumber" class="form-label"></label><input asp-for="RegistrationNumber" class="form-control" /><span asp-validation-for="RegistrationNumber" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Specialization" class="form-label"></label><input asp-for="Specialization" class="form-control" /><span asp-validation-for="Specialization" class="text-danger"></span></div>
    <div class="col-md-12"><label asp-for="Qualifications" class="form-label"></label><textarea asp-for="Qualifications" class="form-control" rows="2"></textarea></div>
    <div class="col-md-4"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="DepartmentId" class="form-label"></label><select asp-for="DepartmentId" class="form-select"><option value="">Select department</option>@foreach (var department in (IEnumerable<HospitalManagementSystem.Web.Models.Department>)ViewBag.Departments) { <option value="@department.Id">@department.Name</option> }</select><span asp-validation-for="DepartmentId" class="text-danger"></span></div>
    @if (User.IsInRole("Administrator"))
    {
        <div class="col-md-12"><label asp-for="ApplicationUserId" class="form-label">Identity account</label><select asp-for="ApplicationUserId" class="form-select"><option value="">No linked account</option>@foreach (var account in (IEnumerable<HospitalManagementSystem.Web.Models.ApplicationUser>)ViewBag.DoctorAccounts) { <option value="@account.Id">@account.Email</option> }</select></div>
    }
</div>
<div class="mt-3"></div>
