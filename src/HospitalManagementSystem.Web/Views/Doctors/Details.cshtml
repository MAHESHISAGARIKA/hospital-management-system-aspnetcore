@model HospitalManagementSystem.Web.Models.ViewModels.DoctorProfileViewModel
@{
    ViewData["Title"] = "Doctor profile";
}

@if (TempData["StatusMessage"] is string message) { <div class="alert alert-success">@message</div> }
@if (TempData["StatusError"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1 class="h3 mb-1">Dr. @Model.Doctor.FirstName @Model.Doctor.LastName</h1><span class="text-muted">@Model.Doctor.DoctorNumber</span></div>
    @if (User.IsInRole("Administrator")) { <a asp-action="Edit" asp-route-id="@Model.Doctor.Id" class="btn btn-primary">Edit doctor</a> }
</div>

<div class="row g-3">
    <div class="col-lg-6"><div class="card h-100"><div class="card-body"><h2 class="h5">Professional details</h2><dl class="row mb-0"><dt class="col-sm-5">Registration number</dt><dd class="col-sm-7">@Model.Doctor.RegistrationNumber</dd><dt class="col-sm-5">Specialization</dt><dd class="col-sm-7">@Model.Doctor.Specialization</dd><dt class="col-sm-5">Qualifications</dt><dd class="col-sm-7">@(Model.Doctor.Qualifications ?? "Not provided")</dd><dt class="col-sm-5">Department</dt><dd class="col-sm-7">@Model.Doctor.Department?.Name</dd><dt class="col-sm-5">Status</dt><dd class="col-sm-7">@(Model.Doctor.IsActive ? "Active" : "Inactive")</dd></dl></div></div></div>
    <div class="col-lg-6"><div class="card h-100"><div class="card-body"><h2 class="h5">Contact details</h2><dl class="row mb-0"><dt class="col-sm-5">Phone</dt><dd class="col-sm-7">@(Model.Doctor.PhoneNumber ?? "Not provided")</dd><dt class="col-sm-5">Email</dt><dd class="col-sm-7">@(Model.Doctor.Email ?? "Not provided")</dd><dt class="col-sm-5">Identity account</dt><dd class="col-sm-7">@(Model.Doctor.ApplicationUserId.HasValue ? "Linked" : "Not linked")</dd></dl></div></div></div>
</div>

<div class="card mt-3"><div class="card-body"><h2 class="h5">Weekly schedule</h2><p class="text-muted">Timezone: Asia/Colombo. Overnight schedules are not supported.</p>
@if (Model.Schedules.Count == 0) { <div class="alert alert-light border mb-0">No working schedule recorded.</div> }
else
{
    <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Day</th><th>Start</th><th>End</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var schedule in Model.Schedules) { <tr><td>@((DayOfWeek)((schedule.DayOfWeek == 7 ? 0 : schedule.DayOfWeek)))</td><td>@schedule.StartTime.ToString("HH:mm")</td><td>@schedule.EndTime.ToString("HH:mm")</td><td>@(schedule.IsActive ? "Active" : "Inactive")</td><td>@if (User.IsInRole("Administrator") || User.IsInRole("Doctor")) { <form asp-action="DeactivateSchedule" method="post" class="d-inline"><input type="hidden" name="id" value="@schedule.Id" /><input type="hidden" name="doctorId" value="@Model.Doctor.Id" /><button class="btn btn-sm btn-outline-secondary" type="submit">Deactivate</button></form> }</td></tr> }</tbody></table></div>
}
@if (User.IsInRole("Administrator") || User.IsInRole("Doctor"))
{
    <form asp-action="Schedule" method="post" class="row g-2 mt-2">
        <input type="hidden" name="DoctorId" value="@Model.Doctor.Id" />
        <div class="col-md-3"><label class="form-label" for="scheduleDay">Day</label><select id="scheduleDay" name="DayOfWeek" class="form-select"><option value="1">Monday</option><option value="2">Tuesday</option><option value="3">Wednesday</option><option value="4">Thursday</option><option value="5">Friday</option><option value="6">Saturday</option><option value="7">Sunday</option></select></div>
        <div class="col-md-3"><label class="form-label" for="startTime">Start time</label><input id="startTime" name="StartTime" type="time" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label" for="endTime">End time</label><input id="endTime" name="EndTime" type="time" class="form-control" /></div>
        <div class="col-md-3 d-flex align-items-end"><button type="submit" class="btn btn-primary w-100">Add session</button></div>
    </form>
}
</div></div>

@if (User.IsInRole("Administrator"))
{
    <div class="mt-3">
        @if (Model.Doctor.IsActive) { <form asp-action="Deactivate" asp-route-id="@Model.Doctor.Id" method="post" class="d-inline"><button type="submit" class="btn btn-outline-danger">Deactivate doctor</button></form> }
        else { <form asp-action="Reactivate" asp-route-id="@Model.Doctor.Id" method="post" class="d-inline"><button type="submit" class="btn btn-outline-success">Reactivate doctor</button></form> }
    </div>
}
