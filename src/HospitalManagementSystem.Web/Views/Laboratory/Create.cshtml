@model LabRequestPage
@{
    ViewData["Title"] = "Request laboratory tests";
}
<h1 class="h3">Request laboratory tests</h1>
<p class="text-muted">@Model.Patient</p>
<form asp-action="Create" asp-route-id="@Model.EncounterId" method="post" data-lab-form>
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <input asp-for="Input.RequestKey" type="hidden" />
    <fieldset class="border rounded p-3 mb-3">
        <legend class="float-none w-auto fs-6 px-1">Active tests</legend>
        @if (Model.Tests.Count == 0) { <p class="text-muted mb-0">There are no active tests available to request.</p> }
        <div class="row g-2">
        @foreach (var test in Model.Tests)
        {
            <div class="col-md-6"><label class="form-check">
                <input class="form-check-input" type="checkbox" name="Input.TestIds" value="@test.Id" checked="@Model.Input.TestIds.Contains(test.Id)" />
                <span class="form-check-label">@test.Code ? @test.Name <small class="text-muted">(@test.Specimen)</small></span>
            </label></div>
        }
        </div>
    </fieldset>
    <label asp-for="Input.Instructions" class="form-label">Clinical request instructions (optional)</label>
    <textarea asp-for="Input.Instructions" maxlength="1000" rows="3" class="form-control mb-3"></textarea>
    <button class="btn btn-primary" disabled="@(Model.Tests.Count == 0)">Submit request</button>
    <a asp-controller="MedicalRecords" asp-action="Encounter" asp-route-id="@Model.EncounterId" class="btn btn-outline-secondary">Back to encounter</a>
</form>
@section Scripts {
    <script src="~/js/laboratory.js" asp-append-version="true"></script>
}
