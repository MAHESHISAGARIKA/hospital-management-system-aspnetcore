@model HospitalManagementSystem.Web.Models.ViewModels.ReportPage
@{
    ViewData["Title"] = "Dashboard";
}
<h1>Hospital Dashboard</h1>
@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success">@statusMessage</div>
}
<p class="d-print-none">Signed in as <strong>@ViewData["AccountEmail"]</strong></p>
<p class="d-print-none">Roles: @ViewData["AccountRoles"]</p>
@if (User.IsInRole("Administrator"))
{
    <a asp-controller="Users" asp-action="Index" class="btn btn-outline-primary mb-3 d-print-none">Manage users</a>
}
<partial name="_HospitalReport" model="Model" />
