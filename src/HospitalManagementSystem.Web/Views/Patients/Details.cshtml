@model HospitalManagementSystem.Web.Models.ViewModels.PatientProfileViewModel
@{
    ViewData["Title"] = "Patient profile";
}

@if (TempData["StatusMessage"] is string message) { <div class="alert alert-success">@message</div> }
@if (TempData["DocumentError"] is string documentError) { <div class="alert alert-danger">@documentError</div> }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1 class="h3 mb-1">@Model.Patient.FirstName @Model.Patient.LastName</h1><span class="text-muted">@Model.Patient.PatientNumber</span></div>
    @if (User.IsInRole("Administrator") || User.IsInRole("Receptionist"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Patient.Id" class="btn btn-primary">Edit patient</a>
    }
</div>

<div class="row g-3">
    <div class="col-lg-6"><div class="card h-100"><div class="card-body"><h2 class="h5">Personal details</h2><dl class="row mb-0"><dt class="col-sm-5">Date of birth</dt><dd class="col-sm-7">@Model.Patient.DateOfBirth.ToString("yyyy-MM-dd")</dd><dt class="col-sm-5">Gender</dt><dd class="col-sm-7">@Model.Patient.Gender</dd><dt class="col-sm-5">NIC</dt><dd class="col-sm-7">@(Model.Patient.NIC ?? "Not provided")</dd><dt class="col-sm-5">Blood group</dt><dd class="col-sm-7">@(Model.Patient.BloodGroup ?? "Not known")</dd><dt class="col-sm-5">Status</dt><dd class="col-sm-7">@(Model.Patient.IsActive ? "Active" : "Archived")</dd></dl></div></div></div>
    <div class="col-lg-6"><div class="card h-100"><div class="card-body"><h2 class="h5">Contact details</h2><dl class="row mb-0"><dt class="col-sm-5">Phone</dt><dd class="col-sm-7">@(Model.Patient.PhoneNumber ?? "Not provided")</dd><dt class="col-sm-5">Email</dt><dd class="col-sm-7">@(Model.Patient.Email ?? "Not provided")</dd><dt class="col-sm-5">Address</dt><dd class="col-sm-7">@(Model.Patient.Address ?? "Not provided")</dd><dt class="col-sm-5">Emergency contact</dt><dd class="col-sm-7">@(Model.Patient.EmergencyContactName ?? "Not provided")</dd><dt class="col-sm-5">Emergency phone</dt><dd class="col-sm-7">@(Model.Patient.EmergencyContactPhone ?? "Not provided")</dd></dl></div></div></div>
</div>

@if (User.IsInRole("Doctor"))
{
    <div class="card mt-3"><div class="card-body">
        <h2 class="h5">Medical history</h2>
        <a asp-controller="MedicalRecords" asp-action="Index" class="btn btn-outline-primary">Open medical records</a>
    </div></div>
}

<div class="card mt-3"><div class="card-body"><h2 class="h5">Documents</h2>
    @if (User.IsInRole("Administrator") || User.IsInRole("Doctor"))
    {
        <form asp-action="UploadDocument" asp-route-id="@Model.Patient.Id" method="post" enctype="multipart/form-data" class="mb-3">
            <div class="row g-2"><div class="col-md-8"><input type="file" name="file" accept=".pdf,.jpg,.jpeg,.png" class="form-control" /></div><div class="col-md-4"><button type="submit" class="btn btn-primary w-100">Upload document</button></div></div>
        </form>
    }
    @if (Model.Documents.Count == 0) { <p class="text-muted mb-0">No documents uploaded.</p> }
    else
    {
        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>File</th><th>Uploaded</th><th>Size</th><th></th></tr></thead><tbody>@foreach (var document in Model.Documents) { <tr><td>@document.OriginalFileName</td><td>@document.UploadedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</td><td>@((document.SizeBytes / 1024.0).ToString("0.##")) KB</td><td>@if (User.IsInRole("Administrator") || User.IsInRole("Doctor")) { <a asp-action="DownloadDocument" asp-route-id="@document.Id" class="btn btn-sm btn-outline-primary">Download</a> }</td></tr> }</tbody></table></div>
    }
</div></div>

@if (User.IsInRole("Administrator"))
{
    <div class="mt-3">
        @if (Model.Patient.IsActive)
        { <form asp-action="Archive" asp-route-id="@Model.Patient.Id" method="post" class="d-inline"><button type="submit" class="btn btn-outline-danger">Archive patient</button></form> }
        else
        { <form asp-action="Reactivate" asp-route-id="@Model.Patient.Id" method="post" class="d-inline"><button type="submit" class="btn btn-outline-success">Reactivate patient</button></form> }
    </div>
}
