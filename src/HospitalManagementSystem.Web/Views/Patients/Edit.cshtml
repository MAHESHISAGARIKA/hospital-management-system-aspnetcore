@model HospitalManagementSystem.Web.Models.ViewModels.PatientEditViewModel
@{
    ViewData["Title"] = "Edit patient";
}

<h1 class="h3 mb-3">Edit @Model.PatientNumber</h1>
@if (TempData["ConcurrencyError"] is string error) { <div class="alert alert-danger">@error</div> }
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden" /><input asp-for="ConcurrencyToken" type="hidden" /><input asp-for="PatientNumber" type="hidden" />
    @await Html.PartialAsync("_PatientForm", Model)
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
</form>
