@model MedicineBatch
@{ ViewData["Title"] = "Stock adjustment"; }
<h1 class="h3">Stock adjustment</h1>
<partial name="_Links" /><partial name="_Messages" />
<div class="card mb-3"><div class="card-body">
    <h2 class="h5">@Model.Medicine.GenericName ? @Model.Number</h2>
    <p class="mb-0">Balance @Model.Available.ToString("0.###") @Model.Unit ? @Model.Status ? expiry @Model.Expiry.ToString("dd MMM yyyy")</p>
</div></div>
<form asp-action="Adjust" asp-route-id="@Model.Id" method="post" data-pharmacy-form data-confirm="Record this inventory change?" class="row g-3">
    <input type="hidden" name="Token" value="@Model.ConcurrencyToken" />
    <input type="hidden" name="RequestKey" value="@Guid.NewGuid()" />
    <label class="col-md-4">Change <select name="Kind" required class="form-select">
        <option value="">Choose an action</option><option>Increase</option><option>Decrease</option>
        <option>Quarantined</option><option>Recalled</option><option>Removed</option>
    </select></label>
    <label class="col-md-4">Quantity (zero for quarantine or recall) <input name="Quantity" inputmode="decimal" required class="form-control" /></label>
    <label class="col-12">Reason <textarea name="Reason" maxlength="500" required class="form-control"></textarea></label>
    <div><button class="btn btn-primary">Record change</button>
        <a asp-action="Reports" asp-route-batchId="@Model.Id" class="btn btn-outline-secondary">Batch movements</a></div>
</form>
@section Scripts { <script src="~/js/pharmacy.js" asp-append-version="true"></script> }
