@model MedicineCatalogInput
@{ ViewData["Title"] = Model.Token == Guid.Empty ? "Register medicine" : "Edit medicine"; }
<h1 class="h3">@ViewData["Title"]</h1>
<form asp-action="SaveMedicine" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post" data-pharmacy-form class="row g-3">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="Token" type="hidden" />
    <label class="col-md-3">Medicine code <input asp-for="Code" maxlength="30" required class="form-control" /></label>
    <label class="col-md-5">Generic name <input asp-for="GenericName" maxlength="150" required class="form-control" /></label>
    <label class="col-md-4">Brand name <input asp-for="BrandName" maxlength="150" class="form-control" /></label>
    <label class="col-md-4">Strength <input asp-for="Strength" maxlength="80" required class="form-control" /></label>
    <label class="col-md-4">Dosage form <input asp-for="Form" maxlength="80" required class="form-control" /></label>
    <label class="col-md-4">Stock unit <select asp-for="Unit" asp-items="Html.GetEnumSelectList<PharmacyUnit>()" class="form-select"></select></label>
    <label class="col-md-6">Manufacturer <input asp-for="Manufacturer" maxlength="150" class="form-control" /></label>
    <label class="col-md-6">Reorder threshold <input asp-for="ReorderThreshold" inputmode="decimal" class="form-control" /></label>
    <label class="col-12">Description <textarea asp-for="Description" maxlength="500" class="form-control"></textarea></label>
    <label class="col-12"><input asp-for="IsActive" /> Active</label>
    <div><button class="btn btn-primary">Save medicine</button> <a asp-action="Medicines" class="btn btn-outline-secondary">Catalog</a></div>
</form>
@section Scripts { <script src="~/js/pharmacy.js" asp-append-version="true"></script> }
