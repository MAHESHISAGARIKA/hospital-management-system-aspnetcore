@model (int Current, int Total)
@{
    var pages = Math.Max(1, (int)Math.Ceiling((double)Model.Total / PharmacyService.PageSize));
    var route = Context.Request.Query.Where(pair => !pair.Key.Equals("Page", StringComparison.OrdinalIgnoreCase))
        .ToDictionary(pair => pair.Key, pair => pair.Value.ToString());
}
<nav aria-label="Result pagination" class="d-flex gap-2 align-items-center d-print-none">
    @foreach (var link in new[] { (Text: "Previous", Page: Model.Current - 1), (Text: "Next", Page: Model.Current + 1) })
    {
        if (link.Page >= 1 && link.Page <= pages)
        {
            var values = new Dictionary<string, string>(route) { ["Page"] = link.Page.ToString() };
            <a asp-action="@ViewContext.RouteData.Values["action"]" asp-all-route-data="values" class="btn btn-sm btn-outline-secondary">@link.Text</a>
        }
    }
    <span>Page @Model.Current of @pages | @Model.Total records</span>
</nav>
