@model BillingPage<BillableService>
@{ ViewData["Title"] = "Service pricing"; }
<h1 class="h3">Service pricing</h1>
<partial name="_Links" />
<a asp-action="Service" class="btn btn-primary mb-3">Register service</a>
<form method="get" asp-action="Services" class="hms-filter row g-2 mb-3">
    <label class="col-md-4">Code or service <input name="Search" value="@Model.Filter.Search" maxlength="100" class="form-control" /></label>
    <label class="col-md-3">Category <select name="Category" class="form-select"><option value="">All</option>
        @foreach (var kind in Enum.GetValues<BillingCategory>())
        { <option value="@kind" selected="@(kind == Model.Filter.Category)">@kind</option> }
    </select></label>
    <label class="col-md-2">Availability <select name="Active" class="form-select"><option value="">All</option>
        <option value="true" selected="@(Model.Filter.Active == true)">Active</option>
        <option value="false" selected="@(Model.Filter.Active == false)">Inactive</option>
    </select></label>
    <div class="col-md-3 align-self-end"><button class="btn btn-outline-primary">Filter</button></div>
</form>
@if (Model.Rows.Count == 0) { <p class="hms-empty">No services match these filters.</p> }
else
{
    <div class="table-responsive"><table class="table"><thead><tr><th>Code</th><th>Service</th><th>Category</th><th>Status</th></tr></thead><tbody>
    @foreach (var service in Model.Rows)
    {
        <tr><td><a asp-action="Service" asp-route-id="@service.Id">@service.Code</a></td><td>@service.Name</td>
            <td>@service.Category</td><td>@(service.Active ? "Active" : "Inactive")</td></tr>
    }
    </tbody></table></div>
    <partial name="_Paging" model="(Model.Filter.Page, Model.Total)" />
}
