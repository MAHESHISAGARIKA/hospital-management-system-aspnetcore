@model HospitalManagementSystem.Web.Models.Department
@{ ViewData["Title"] = "Edit department"; }
<h1 class="h3 mb-3">Edit department</h1>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-action="Edit" method="post"><input asp-for="Id" type="hidden" /><div class="mb-3"><label asp-for="DepartmentCode" class="form-label"></label><input asp-for="DepartmentCode" class="form-control" /></div><div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div><div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active</label></div><button type="submit" class="btn btn-primary">Save</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form>
