@model IReadOnlyCollection<HospitalManagementSystem.Web.Models.Department>
@{ ViewData["Title"] = "Departments"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3 mb-0">Departments</h1><a asp-action="Create" class="btn btn-primary">Create department</a></div>
@if (TempData["StatusMessage"] is string message) { <div class="alert alert-success">@message</div> }
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Code</th><th>Name</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var department in Model) { <tr><td>@department.DepartmentCode</td><td>@department.Name</td><td>@(department.IsActive ? "Active" : "Inactive")</td><td><a asp-action="Edit" asp-route-id="@department.Id" class="btn btn-sm btn-outline-primary">Edit</a></td></tr> }</tbody></table></div>
